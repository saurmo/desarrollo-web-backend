# Configuración de base de datos Postgres (Supabase)
DATABASE_URL=postgres://user:password@localhost:5432/donaciones_db
DIRECT_URL=postgres://user:password@localhost:5432/donaciones_db

# Auth
JWT_SECRET=tu_secreto_jwt
PORT=3001

# Almacenamiento S3 / Supabase Storage (opcional)
SUPABASE_S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
SUPABASE_STORAGE_PUBLIC_URL=
