{
  "compilerOptions": {
    "target": "ES2017",
    "outDir": "./dist",
    "rootDir": "./",
    "module": "es2015",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
     "experimentalDecorators": true
  }
}